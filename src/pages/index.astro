---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import WorkExperience from '../components/WorkExperience.astro';
import Hobbies from '../components/Hobbies.astro';
import badges from '../assets/88x31s.json';

import resumeSvg from '../assets/icons/resume.svg';
import githubSvg from '../assets/icons/github.svg';
import linkedinSvg from '../assets/icons/linkedin.svg';
import blogSvg from '../assets/icons/blog.svg';
---

<Base>
  <div class="column">
    <div style="padding-block: 1rem">
      <Section>
        <div
          style="display:flex; justify-content:center; align-items:center; gap:1rem;"
        >
          <img src="/logo.svg" alt="" style="height: 5rem;" />
          <h1 style="font-size: 3rem; margin-block: 0;">
            ava <span class="full-name">silver</span>
          </h1>
        </div>
      </Section>
    </div>

    <Section>
      <h2 style="font-size: 2rem;">hiya there!</h2>
      <p style="font-size: 1.25rem; margin-block: 0;">
        i'm ava silver (<span class="pronouns">she/her</span>). welcome to my
        corner of the internet! <span id="cat"></span>
      </p>
    </Section>

    <Section>
      <div style="display: flex; flex-direction: column;">
        <WorkExperience />

        <div style="padding: 4px;"></div>

        <Hobbies />
      </div>
    </Section>

    <Section>
      <div style="display: flex; justify-content: space-around;">
        <a href="/resume.pdf" class="clickable resource">
          Resume
          <Image src={resumeSvg} alt="Resume" />
        </a>
        <a
          href="https://www.linkedin.com/in/ava-silver/"
          class="clickable resource"
        >
          LinkedIn
          <Image src={linkedinSvg} alt="LinkedIn" />
        </a>
        <a href="https://github.com/ava-silver" class="clickable resource">
          Github
          <Image src={githubSvg} alt="Github" />
        </a>
        <a href="/blog" class="clickable resource">
          Blog
          <Image src={blogSvg} alt="Blog" />
        </a>
      </div>
    </Section>

    <Section>
      <div
        style="display: flex; flex-wrap: wrap; gap: 1rem; justify-content: center; align-items: center;"
      >
        {
          badges.map(({ name, image, url, ...rest }) => (
            <a href={url} data-neko="true">
              <img
                src={'/badges/' + image}
                data-alt-badge={'alt' in rest ? rest.alt : undefined}
                alt={name}
                height="31"
                width="88"
                loading="lazy"
                decoding="async"
                style="image-rendering: pixelated;"
              />
            </a>
          ))
        }
      </div>
    </Section>

    <div
      style="display: flex; justify-content: center; gap: 2rem; align-items: center;"
    >
      <span>Ava Silver {new Date().getFullYear()}</span>
      <a href="mailto:ava@avasilver.dev" class="clickable">ava@avasilver.dev</a>
      <a
        href="https://github.com/ava-silver/personal-website/"
        class="clickable resource"
      >
        source code
        <Image src={githubSvg} alt="source code" loading="lazy" />
      </a>
    </div>
  </div>

  <script>
    const cat = document.getElementById('cat');
    if (cat && Math.random() < 0.4) cat.textContent = ':3';

    // ~10% of visitors get the alt 88x31 badges
    if (Math.random() < 0.1) {
      document
        .querySelectorAll<HTMLImageElement>('img[data-alt-badge]')
        .forEach((img) => {
          img.src = '/badges/' + img.dataset.altBadge;
        });
    }
  </script>
</Base>
