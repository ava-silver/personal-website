---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Base title="Blog | Ava Silver">
  <div class="column">
    <div class="back-row">
      <a href="/" aria-label="Home" class="clickable" style="padding: 0;">
        <svg
          width="1.25em"
          height="1.25em"
          viewBox="0 0 24 24"
          fill="currentColor"
          style="margin-right: 8px; vertical-align: middle;"
        >
          <path
            d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"
          ></path>
        </svg>
      </a>
    </div>

    {
      posts.map(({ id, data }) => (
        <a href={`/blog/${id}`} style="color: inherit; text-decoration: none;">
          <Section class="clickable">
            <p style="font-size: 1.5rem; margin-block: 0 4px;">{data.title}</p>
            <p style="font-weight: 300; margin-block: 0;">{data.description}</p>
          </Section>
        </a>
      ))
    }
  </div>
</Base>
