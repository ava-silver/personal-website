---
interface Props {
  name: string;
  icon: string;
  titleSize?: string;
  open?: boolean;
}

const { name, icon, titleSize = '0.75em', open = false } = Astro.props;
---

<details class="acc-section" open={open || undefined}>
  <summary>
    <span class="acc-header" style={`font-size: ${titleSize}`}>
      <span class="acc-icon-box">
        <img src={icon} alt={`${name} Icon`} />
      </span>
      {name}
    </span>
    <svg
      class="acc-chevron"
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="m6 9 6 6 6-6"></path>
    </svg>
  </summary>
  <div class="acc-content">
    <slot />
  </div>
</details>
